model DefensiveMatchupAssignment {
  id                       String   @id @default(uuid())
  eventId                  String
  defenseTeamId            String
  defenderPlayerId         String
  offensivePlayerId        String
  expectedPossessionShare  Float
  confirmed                Boolean  @default(false)
  source                   String
  sourceTier               SourceTier
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  event                    Event    @relation(fields: [eventId], references: [id])
  defenseTeam              Team     @relation("DefensiveTeam", fields: [defenseTeamId], references: [id])
  defenderPlayer           Player   @relation("DefenderPlayer", fields: [defenderPlayerId], references: [id])
  offensivePlayer          Player   @relation("OffensivePlayer", fields: [offensivePlayerId], references: [id])

  @@unique([eventId, defenderPlayerId, offensivePlayerId])
  @@index([eventId])
  @@index([defenderPlayerId])
  @@index([offensivePlayerId])
  @@map("defensive_matchup_assignments")
}

// ============================================================
// FIVE-MAN LINEUPS & ON/OFF
// ============================================================
model FiveManLineup {
  id          String   @id @default(uuid())
  teamId      String
  season      String
  lineupKey   String
  createdAt   DateTime @default(now())

  team        Team     @relation(fields: [teamId], references: [id])
  players     FiveManLineupPlayer[]
  stats       FiveManLineupStat[]

  @@unique([teamId, season, lineupKey])
  @@index([teamId])
  @@index([season])
  @@map("five_man_lineups")
}

model FiveManLineupPlayer {
  id        String @id @default(uuid())
  lineupId  String
  playerId  String
  slot      Int

  lineup    FiveManLineup @relation(fields: [lineupId], references: [id])
  player    Player        @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
  @@unique([lineupId, slot])
  @@index([playerId])
  @@map("five_man_lineup_players")
}

model FiveManLineupStat {
  id          String   @id @default(uuid())
  lineupId    String
  eventId     String?
  sampleStart DateTime?
  sampleEnd   DateTime?
  possessions Float    @default(0)
  minutes     Float    @default(0)
  ortg        Float    @default(0)
  drtg        Float    @default(0)
  netRating   Float    @default(0)
  pace        Float    @default(0)
  source      String
  sourceTier  SourceTier
  calculatedAt DateTime @default(now())

  lineup      FiveManLineup @relation(fields: [lineupId], references: [id])
  event       Event?        @relation(fields: [eventId], references: [id])

  @@index([lineupId])
  @@index([eventId])
  @@index([calculatedAt])
  @@map("five_man_lineup_stats")
}

model PlayerOnOffStat {
  id                    String   @id @default(uuid())
  playerId              String
  teamId                String
  season                String
  sampleStart           DateTime?
  sampleEnd             DateTime?
  minutesOn             Float    @default(0)
  minutesOff            Float    @default(0)
  ortgOn                Float    @default(0)
  ortgOff               Float    @default(0)
  drtgOn                Float    @default(0)
  drtgOff               Float    @default(0)
  netRatingOn           Float    @default(0)
  netRatingOff          Float    @default(0)
  paceOn                Float    @default(0)
  paceOff               Float    @default(0)
  usageDelta            Float    @default(0)
  assistRateDelta       Float    @default(0)
  reboundRateDelta      Float    @default(0)
  fgaRateDelta          Float    @default(0)
  threePointRateDelta   Float    @default(0)
  rimRateDelta          Float    @default(0)
  source                String
  sourceTier            SourceTier
  calculatedAt          DateTime @default(now())

  player                Player   @relation(fields: [playerId], references: [id])
  team                  Team     @relation(fields: [teamId], references: [id])

  @@index([playerId, season])
  @@index([teamId, season])
  @@index([calculatedAt])
  @@map("player_on_off_stats")
}

// ============================================================
// INJURY REPLACEMENT MODEL INPUTS
// ============================================================
model InjuryReplacementProjection {
  id                    String   @id @default(uuid())
  eventId               String
  absentPlayerId        String
  replacementPlayerId   String
  minutesDelta          Float    @default(0)
  usageDelta            Float    @default(0)
  ballHandlingDelta     Float    @default(0)
  reboundChanceDelta    Float    @default(0)
  fgaDelta              Float    @default(0)
  threePointAttemptDelta Float   @default(0)
  defensiveImpact       Float    @default(0)
  confidence            Float    @default(0)
  dataQuality           DataQualityLevel
  projectedAt           DateTime @default(now())

  event                 Event    @relation(fields: [eventId], references: [id])
  absentPlayer          Player   @relation("AbsentPlayer", fields: [absentPlayerId], references: [id])
  replacementPlayer     Player   @relation("ReplacementPlayer", fields: [replacementPlayerId], references: [id])

  @@unique([eventId, absentPlayerId, replacementPlayerId])
  @@index([eventId])
  @@index([absentPlayerId])
  @@index([replacementPlayerId])
  @@map("injury_replacement_projections")
}

// ============================================================
// PERFORMANCE, CLV & POST-BET ATTRIBUTION
// ============================================================
model PostBetReview {
  id                       String   @id @default(uuid())
  betSlipItemId            String   @unique
  processGrade             ProcessGrade
  expectedMinutes          Float?
  actualMinutes            Float?
  minutesProjectionError   Float?
  expectedUsage            Float?
  actualUsage              Float?
  usageProjectionError     Float?
  expectedPace             Float?
  actualPace               Float?
  paceProjectionError      Float?
  rotationError            Boolean  @default(false)
  matchupError             Boolean  @default(false)
  marketTimingError        Boolean  @default(false)
  varianceDominated        Boolean  @default(false)
  foulTrouble              Boolean  @default(false)
  blowout                  Boolean  @default(false)
  inGameInjury             Boolean  @default(false)
  unexpectedCoachingDecision Boolean @default(false)
  primaryError             ErrorAttributionType?
  notes                    String?
  reviewedAt               DateTime @default(now())

  betSlipItem              BetSlipItem @relation(fields: [betSlipItemId], references: [id])

  @@index([primaryError])
  @@index([reviewedAt])
  @@map("post_bet_reviews")
}

enum ProcessGrade {
  CORRECT
  MOSTLY_CORRECT
  MIXED
  MOSTLY_INCORRECT
  INCORRECT
}

enum ErrorAttributionType {
  MINUTES_PROJECTION
  USAGE_PROJECTION
  INJURY_INFORMATION
  ROTATION
  MATCHUP
  PACE
  EFFICIENCY
  MARKET_TIMING
  PRICE
  VARIANCE
  FOUL_TROUBLE
  BLOWOUT
  IN_GAME_INJURY
  UNEXPECTED_COACHING
}

model PerformanceSlice {
  id             String   @id @default(uuid())
  userId         String?
  modelId        String?
  period         String
  dimension      PerformanceDimension
  dimensionValue String
  totalBets      Int      @default(0)
  wins           Int      @default(0)
  losses         Int      @default(0)
  pushes         Int      @default(0)
  units          Float    @default(0)
  roi            Float    @default(0)
  averageOdds    Float    @default(0)
  clvRate        Float    @default(0)
  averageClv     Float    @default(0)
  calculatedAt   DateTime @default(now())

  user           User?       @relation(fields: [userId], references: [id])
  model          CustomModel? @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
  @@index([dimension, dimensionValue])
  @@index([calculatedAt])
  @@map("performance_slices")
}

enum PerformanceDimension {
  CONFIDENCE
  PROP_TYPE
  DIRECTION
  SEASON_PHASE
  MARKET_TYPE
  SPORTSBOOK
}

// ============================================================
// EXPERT PICKS
// ============================================================
model ExpertPick {
  id          String    @id @default(uuid())
  expertName  String
  source      String    @default("manual")
  marketId    String
  outcome     String
  odds        Int?
  confidence  Int       @default(3)  // 1–5 stars
  reasoning   String?
  result      String?   // "WIN" | "LOSS" | "PUSH" | null = pending
  pickedAt    DateTime  @default(now())
  resolvedAt  DateTime?

  market      Market    @relation(fields: [marketId], references: [id])

  @@index([marketId])
  @@index([expertName])
  @@index([pickedAt])
  @@map("expert_picks")
}