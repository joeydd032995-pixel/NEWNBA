  event       Event?       @relation(fields: [eventId], references: [id])

  @@index([playerId, playType])
  @@index([eventId])
  @@index([season])
  @@map("player_play_type_stats")
}

enum PlayType {
  PICK_AND_ROLL_BALL_HANDLER
  PICK_AND_ROLL_ROLL_MAN
