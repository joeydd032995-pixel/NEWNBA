  minutes            Float    @default(0)
  rimAttempts        Float    @default(0)
  rimFrequency       Float    @default(0)
  rimEfficiency      Float    @default(0)
  midrangeAttempts   Float    @default(0)
  midrangeFrequency  Float    @default(0)
  midrangeEfficiency Float    @default(0)
  corner3Attempts    Float    @default(0)
  corner3Frequency   Float    @default(0)
  corner3Efficiency  Float    @default(0)
  atb3Attempts       Float    @default(0)
  atb3Frequency      Float    @default(0)
  atb3Efficiency     Float    @default(0)
  catchShootAttempts Float    @default(0)
  catchShootFrequency Float   @default(0)
  catchShootEfficiency Float  @default(0)
  pullupAttempts     Float    @default(0)
  pullupFrequency    Float    @default(0)
  pullupEfficiency   Float    @default(0)
  expectedEfg        Float    @default(0)
  source             String
  sourceTier         SourceTier
  createdAt          DateTime @default(now())

  player             Player   @relation(fields: [playerId], references: [id])
  event              Event?   @relation(fields: [eventId], references: [id])

  @@index([playerId, gameDate])
  @@index([eventId])
  @@index([season])
  @@map("player_shot_profiles")
}

model PlayerPlayTypeStat {
  id          String       @id @default(uuid())
  playerId    String
  eventId     String?
  season      String
  gameDate    DateTime?
  playType    PlayType
  possessions Float        @default(0)
  frequency   Float        @default(0)
  pointsPerPossession Float @default(0)
  efgPct      Float        @default(0)
  turnoverPct Float        @default(0)
  freeThrowFrequency Float  @default(0)
  source      String
