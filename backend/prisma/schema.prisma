  PUTBACK
}

model TeamDefensiveSchemeStat {
  id                     String   @id @default(uuid())
  teamId                 String
  eventId                String?
  season                 String
  gameDate               DateTime?
  switchFrequency        Float    @default(0)
  dropFrequency          Float    @default(0)
  blitzFrequency         Float    @default(0)
  trapFrequency          Float    @default(0)
  zoneFrequency          Float    @default(0)
  doubleTeamRate         Float    @default(0)
  pointOfAttackRating    Float    @default(0)
  helpAggressiveness     Float    @default(0)
  rimProtectionRating    Float    @default(0)
  transitionDefensePpp   Float    @default(0)
